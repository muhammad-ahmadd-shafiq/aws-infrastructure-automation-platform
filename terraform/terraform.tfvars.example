# Copy to terraform.tfvars (gitignored) for local runs, or pass equivalent
# -var flags / TF_VAR_ environment variables in CI.

aws_region = "us-east-1"

# Your public IP in CIDR form — restricts SSH access to the instance.
# Find yours with: curl -s ifconfig.me
my_ip = "203.0.113.42/32"

# Contents of your SSH public key (e.g. ~/.ssh/id_ed25519.pub)
public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your-key-comment"
